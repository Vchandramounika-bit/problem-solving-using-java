import java.io.*;
import java.util.*;

class Result {
    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();
        int numLayers = Math.min(m, n) / 2;

        for (int layer = 0; layer < numLayers; layer++) {
            List<Integer> ring = new ArrayList<>();

            // Top row (left to right)
            for (int col = layer; col < n - layer; col++)
                ring.add(matrix.get(layer).get(col));

            // Right column (top+1 to bottom)
            for (int row = layer + 1; row < m - layer; row++)
                ring.add(matrix.get(row).get(n - layer - 1));

            // Bottom row (right-1 to left)
            for (int col = n - layer - 2; col >= layer; col--)
                ring.add(matrix.get(m - layer - 1).get(col));

            // Left column (bottom-1 to top+1)
            for (int row = m - layer - 2; row > layer; row--)
                ring.add(matrix.get(row).get(layer));

            // Rotate the ring by r positions (anti-clockwise = shift left)
            int size = ring.size();
            int shift = r % size;

            List<Integer> rotated = new ArrayList<>();
            for (int i = shift; i < size; i++) rotated.add(ring.get(i));
            for (int i = 0; i < shift; i++) rotated.add(ring.get(i));

            // Put values back into the matrix
            int idx = 0;

            for (int col = layer; col < n - layer; col++)
                matrix.get(layer).set(col, rotated.get(idx++));

            for (int row = layer + 1; row < m - layer; row++)
                matrix.get(row).set(n - layer - 1, rotated.get(idx++));

            for (int col = n - layer - 2; col >= layer; col--)
                matrix.get(m - layer - 1).set(col, rotated.get(idx++));

            for (int row = m - layer - 2; row > layer; row--)
                matrix.get(row).set(layer, rotated.get(idx++));
        }

        // Print the result
        StringBuilder sb = new StringBuilder();
        for (List<Integer> row : matrix) {
            for (int i = 0; i < row.size(); i++) {
                if (i > 0) sb.append(" ");
                sb.append(row.get(i));
            }
            sb.append("\n");
        }
        System.out.print(sb);
    }
}
